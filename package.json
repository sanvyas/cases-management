{
  "name": "samadhan",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "eslint .",
    "typecheck": "turbo typecheck",
    "test": "pnpm --filter @samadhan/domain test && pnpm --filter @samadhan/i18n test && pnpm --filter @samadhan/api test",
    "test:integration": "turbo test:integration",
    "test:e2e": "pnpm --filter web-staff exec playwright test && pnpm --filter web-citizen exec playwright test",
    "test:mobile": "echo 'Maestro flows - run manually'",
    "test:load": "echo 'k6 scenarios - run manually'",
    "test:ai-eval": "echo 'AI evaluation harness - configure providers first'",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "clean": "turbo clean",
    "db:migrate": "pnpm --filter @samadhan/db migrate",
    "db:seed": "pnpm --filter @samadhan/db seed",
    "openapi": "pnpm --filter @samadhan/contracts generate"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "eslint": "^9.28.0",
    "globals": "^16.1.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.33.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msgpackr-extract",
      "unrs-resolver"
    ],
    "overrides": {
      "postcss@<=8.5.17": "8.5.18",
      "image-size@<=2.0.2": "2.0.3"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-86w9-cpqp-85rv"
      ]
    }
  }
}